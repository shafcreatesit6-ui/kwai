{%- comment -%}
  AP: hero in Popflex-stijl. Twee staande campagnefoto's naast elkaar over de volle breedte (desktop),
  één foto op mobiel. De foto's worden vanaf de bovenkant getoond, zodat hoofden nooit wegvallen.
  Op de homepage schuift de hero onder het (dan transparante) menu; zie sections/ap-popflex.liquid.
{%- endcomment -%}
{%- liquid
  assign ap_sh_left = section.settings.image_left
  assign ap_sh_right = section.settings.image_right | default: section.settings.image_left
  assign ap_sh_mobile = section.settings.image_mobile | default: ap_sh_left
-%}
{%- if ap_sh_left != blank -%}
  <div class="ap-sh" data-ap-hero>
    <div class="ap-sh__media">
      <a class="ap-sh__pic ap-sh__pic--left" href="{{ section.settings.link_left | default: section.settings.link }}" tabindex="-1" aria-hidden="true">
        {{ ap_sh_left | image_url: width: 1400 | image_tag: widths: '700, 1000, 1400', sizes: '(min-width: 750px) 50vw, 100vw', fetchpriority: 'high', loading: 'eager', class: 'ap-sh__img ap-sh__img--desk', alt: ap_sh_left.alt }}
        {{ ap_sh_mobile | image_url: width: 1100 | image_tag: widths: '600, 900, 1100', sizes: '100vw', fetchpriority: 'high', loading: 'eager', class: 'ap-sh__img ap-sh__img--mob', alt: ap_sh_mobile.alt }}
      </a>
      <a class="ap-sh__pic ap-sh__pic--right" href="{{ section.settings.link_right | default: section.settings.link }}" tabindex="-1" aria-hidden="true">
        {{ ap_sh_right | image_url: width: 1400 | image_tag: widths: '700, 1000, 1400', sizes: '50vw', loading: 'eager', class: 'ap-sh__img', alt: ap_sh_right.alt }}
      </a>
    </div>
    <div class="ap-sh__content">
      {%- if section.settings.eyebrow != blank -%}<p class="ap-sh__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ap-sh__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      <div class="ap-sh__btns">
        {%- if section.settings.button_label != blank -%}
          <a class="ap-sh__btn" href="{{ section.settings.link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="ap-sh__btn ap-sh__btn--ghost" href="{{ section.settings.link_2 }}">{{ section.settings.button_label_2 | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

<style>
  .ap-sh { position: relative; overflow: hidden; background: #e9e1d6; }
  .ap-sh__media { display: grid; grid-template-columns: 1fr; }
  .ap-sh__pic { display: block; position: relative; height: min(140vw, calc(100svh - 4rem)); }
  .ap-sh .ap-sh__pic--right, .ap-sh .ap-sh__img--desk { display: none; }
  .ap-sh__img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .ap-sh::after { content: ''; position: absolute; inset: auto 0 0 0; height: 45%; pointer-events: none;
    background: linear-gradient(to top, rgba(20,16,13,.55), rgba(20,16,13,0)); }
  .ap-sh::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 22rem; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom, rgba(20,16,13,.38), rgba(20,16,13,0)); }
  .ap-sh__content { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 0 2rem 4.4rem; text-align: center; color: #fff; }
  .ap-sh__eyebrow { margin: 0 0 1rem; font-family: var(--font-body-family); font-size: 1.1rem; letter-spacing: .34em; text-transform: uppercase; color: #fff; }
  .ap-sh__title { margin: 0; font-family: var(--font-heading-family); font-weight: 400; font-size: clamp(3.6rem, 6vw, 7.2rem); line-height: 1.02; color: #fff; }
  .ap-sh__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.2rem; margin-top: 2.4rem; }
  .ap-sh__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 4.8rem; padding: 0 3.2rem;
    background: #fff; color: #14100d; text-decoration: none; font-family: var(--font-body-family); font-size: 1.2rem;
    letter-spacing: .24em; text-transform: uppercase; transition: background .2s, color .2s; }
  .ap-sh__btn:hover { background: #14100d; color: #fff; }
  .ap-sh__btn--ghost { background: transparent; color: #fff; box-shadow: inset 0 0 0 1px #fff; }
  .ap-sh__btn--ghost:hover { background: #fff; color: #14100d; }
  @media screen and (min-width: 750px) {
    .ap-sh__media { grid-template-columns: 1fr 1fr; }
    .ap-sh__pic { height: min(66vw, calc(100svh - 4rem)); min-height: 56rem; }
    .ap-sh .ap-sh__pic--right, .ap-sh .ap-sh__img--desk { display: block; }
    .ap-sh .ap-sh__img--mob { display: none; }
    .ap-sh__content { padding-bottom: 6.4rem; }
  }
</style>

{% schema %}
{
  "name": "AP split-hero (Popflex)",
  "tag": "section",
  "class": "section ap-sh-section",
  "settings": [
    { "type": "image_picker", "id": "image_left", "label": "Foto links (staand)" },
    { "type": "image_picker", "id": "image_right", "label": "Foto rechts (staand)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Foto mobiel (optioneel, anders links)" },
    { "type": "text", "id": "eyebrow", "label": "Klein kopje" },
    { "type": "text", "id": "heading", "label": "Kop" },
    { "type": "text", "id": "button_label", "label": "Knop" },
    { "type": "url", "id": "link", "label": "Link knop" },
    { "type": "text", "id": "button_label_2", "label": "Knop 2" },
    { "type": "url", "id": "link_2", "label": "Link knop 2" },
    { "type": "url", "id": "link_left", "label": "Link foto links" },
    { "type": "url", "id": "link_right", "label": "Link foto rechts" }
  ],
  "presets": [ { "name": "AP split-hero (Popflex)" } ]
}
{% endschema %}
