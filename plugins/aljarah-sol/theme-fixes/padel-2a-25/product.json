n-items: center; gap: .4rem 1.2rem; margin: -.6rem 0 .4rem; }\n    .ap-sg-link__btn { display: inline-flex; align-items: center; gap: .6rem; padding: .4rem 0; border: 0; background: none; color: inherit; font: inherit; font-size: 1.35rem; text-decoration: underline; text-underline-offset: .35rem; cursor: pointer; }\n    .ap-sg-link__btn svg { width: 1.8rem; height: 1.8rem; fill: none; stroke: currentColor; stroke-width: 1.3; }\n    .ap-sg-link__tip { font-size: 1.25rem; opacity: .7; }\n    .ap-sg { position: fixed; inset: 0; margin: auto; height: fit-content; width: min(64rem, calc(100% - 3.2rem)); max-height: 85vh; overflow: auto; padding: 2.4rem; border: 0; background: rgb(var(--color-background)); color: rgb(var(--color-foreground)); box-shadow: 0 2rem 6rem rgba(0,0,0,.25); }\n    .ap-sg::backdrop { background: rgba(31,26,22,.55); }\n    .ap-sg__head { display: flex; justify-content: space-between; align-items: center; }\n    .ap-sg__title { margin: 0; font-family: var(--font-heading-family); font-size: 2.6rem; font-weight: 300; }\n    .ap-sg__close { width: 4rem; height: 4rem; border: 0; background: none; cursor: pointer; color: inherit; display: grid; place-items: center; }\n    .ap-sg__close svg { width: 1.8rem; height: 1.8rem; stroke: currentColor; stroke-width: 1.4; fill: none; }\n    .ap-sg__sub { margin: .4rem 0 1.6rem; font-size: 1.3rem; opacity: .7; }\n    .ap-sg__table { overflow-x: auto; }\n    .ap-sg__table table { width: 100%; border-collapse: collapse; font-size: 1.35rem; text-align: center; }\n    .ap-sg__table th, .ap-sg__table td { padding: .9rem .8rem; border-bottom: 1px solid rgba(var(--color-foreground), .12); }\n    .ap-sg__table th { font-weight: 500; background: rgba(184,154,94,.12); }\n    .ap-sg__note { margin: 1.6rem 0 0; font-size: 1.3rem; line-height: 1.5; opacity: .85; }\n  </style>\n  <script>\n    (function () {\n      if (window.apSgReady) return;\n      window.apSgReady = true;\n      document.addEventListener('click', function (e