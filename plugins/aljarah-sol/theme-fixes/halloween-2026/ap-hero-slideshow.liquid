{%- comment -%}
  AP hero slideshow — Aljarah Sol.
  Volledige breedte slides die automatisch wisselen. Een rondje onderin telt af
  en is tegelijk de pauzeknop. Elke slide linkt naar een collectie of product.
  v1.4: zachte crossfade (nieuwe foto vervaagt óver de oude, geen donkere dip),
  alle foto's worden vooraf geladen zodat ze op iPhone niet "plop" verschijnen.
{%- endcomment -%}

{%- liquid
  assign slide_count = section.blocks.size
  assign interval = section.settings.interval
-%}

<section
  class="ap-hero ap-hero--{{ section.settings.height }}"
  id="ApHero-{{ section.id }}"
  data-interval="{{ interval }}"
  data-ap-build="1.4"
  aria-roledescription="carrusel"
  aria-label="{{ section.settings.label | escape }}"
>
  <div class="ap-hero__track">
    {%- for block in section.blocks -%}
      {%- assign idx = forloop.index0 -%}
      <div
        class="ap-hero__slide{% if forloop.first %} is-active{% endif %}"
        role="group"
        aria-roledescription="diapositiva"
        aria-label="{{ 'aljarah_corrections.count' | t: current: forloop.index, total: slide_count | escape }}"
        data-index="{{ idx }}"
        {% if forloop.first == false %}aria-hidden="true"{% endif %}
        {{ block.shopify_attributes }}
      >
        <a
          class="ap-hero__link"
          href="{{ block.settings.link | default: '/collections/all' }}"
          {% if forloop.first == false %}tabindex="-1"{% endif %}
        >
          <div class="ap-hero__media">
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign priority = 'low'
                if forloop.first
                  assign priority = 'high'
                endif
              -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w"
                    sizes="100vw"
                  >
                {%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    widths: '600, 900, 1200, 1600, 2000, 2400',
                    sizes: '100vw',
                    loading: 'eager',
                    decoding: 'async',
                    fetchpriority: priority,
                    alt: block.settings.heading,
                    style: block.settings.focal
                }}
              </picture>
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'ap-hero__placeholder' }}
            {%- endif -%}
          </div>

          <div class="ap-hero__content ap-hero__content--{{ section.settings.text_position }}">
            {%- if block.settings.eyebrow != blank -%}
              <p class="ap-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              {%- if forloop.first -%}
                <h2 class="ap-hero__heading">{{ block.settings.heading | escape }}</h2>
              {%- else -%}
                <p class="ap-hero__heading" role="heading" aria-level="2">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="ap-hero__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="ap-hero__button">{{ block.settings.button_label | escape }}</span>
            {%- endif -%}
          </div>
        </a>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="ap-hero__controls">
      <button
        type="button"
        class="ap-hero__timer"
        data-ap-toggle
        aria-label="{{ 'aljarah_corrections.pause' | t | escape }}"
        aria-pressed="false"
      >
        <svg viewBox="0 0 36 36" aria-hidden="true" focusable="false">
          <circle class="ap-hero__ring-bg" cx="18" cy="18" r="16"></circle>
          <circle class="ap-hero__ring" cx="18" cy="18" r="16"></circle>
        </svg>
        <span class="ap-hero__timer-icon" aria-hidden="true"></span>
      </button>
      <ol class="ap-hero__dots">
        {%- for block in section.blocks -%}
          <li>
            <button
              type="button"
              class="ap-hero__dot{% if forloop.first %} is-active{% endif %}"
              data-ap-go="{{ forloop.index0 }}"
              aria-label="{{ 'aljarah_corrections.slide' | t: number: forloop.index, heading: block.settings.heading | escape }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            >
              {%- if forloop.index < 10 -%}0{%- endif -%}{{ forloop.index }}
            </button>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  {%- endif -%}
</section>

<style>
  #ApHero-{{ section.id }} { --ap-interval: {{ interval }}s; --ap-fade: 1.6s; --ap-ease: cubic-bezier(.45, 0, .2, 1); }
  .ap-hero { position: relative; overflow: hidden; background: #1f1a16; color: #fff; }
  .ap-hero__track { position: relative; width: 100%; }
  .ap-hero--tall .ap-hero__track { height: min(88vh, 92rem); min-height: 56rem; }
  .ap-hero--medium .ap-hero__track { height: min(72vh, 76rem); min-height: 48rem; }
  @media (max-width: 749px) {
    .ap-hero--tall .ap-hero__track { height: 82svh; min-height: 52rem; }
    .ap-hero--medium .ap-hero__track { height: 68svh; min-height: 44rem; }
  }

  /* Crossfade: de nieuwe slide (z 2) vervaagt óver de oude (z 1), die blijft volledig zichtbaar tot de fade klaar is. */
  .ap-hero__slide {
    position: absolute; inset: 0; z-index: 0; opacity: 0; visibility: hidden;
    transition: opacity var(--ap-fade) var(--ap-ease), visibility 0s linear var(--ap-fade);
  }
  .ap-hero__slide.is-leaving { z-index: 1; opacity: 1; visibility: visible; transition: none; }
  .ap-hero__slide.is-active {
    z-index: 2; opacity: 1; visibility: visible;
    transition: opacity var(--ap-fade) var(--ap-ease), visibility 0s;
  }

  .ap-hero__link { display: block; position: absolute; inset: 0; color: inherit; text-decoration: none; }
  .ap-hero__link:focus-visible { outline: 2px solid #fff; outline-offset: -6px; }
  .ap-hero__media, .ap-hero__media picture { position: absolute; inset: 0; }
  .ap-hero__media img, .ap-hero__placeholder {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transform: scale(1.06); transition: transform calc(var(--ap-interval) + var(--ap-fade)) linear;
    backface-visibility: hidden; will-change: transform;
  }
  .ap-hero__slide.is-active .ap-hero__media img,
  .ap-hero__slide.is-leaving .ap-hero__media img { transform: scale(1); }
  .ap-hero__media::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(31,26,22,.68) 0%, rgba(31,26,22,.34) 42%, rgba(31,26,22,0) 70%);
  }
  .ap-hero__content {
    position: absolute; left: 0; right: 0; z-index: 2; padding: 0 2.4rem;
    display: flex; flex-direction: column; align-items: center; text-align: center;
  }
  #ApHero-{{ section.id }} .ap-hero__content,
  #ApHero-{{ section.id }} .ap-hero__content > * { color: #fff; }
  .ap-hero__content--bottom { bottom: 11rem; }
  .ap-hero__content--middle { top: 50%; transform: translateY(-50%); }
  @media (min-width: 750px) { .ap-hero__content--bottom { bottom: 12.5rem; } }
  .ap-hero__eyebrow {
    margin: 0 0 1.4rem; font-size: 1.1rem; letter-spacing: .38em; text-transform: uppercase;
    padding-bottom: .5rem; border-bottom: 1px solid rgba(255,255,255,.7);
  }
  .ap-hero__heading {
    margin: 0; font-family: var(--font-heading-family); font-weight: 300; line-height: 1.02;
    font-size: clamp(4rem, 7.2vw, 8.4rem); letter-spacing: .01em; text-shadow: 0 2px 24px rgba(0,0,0,.18);
  }
  .ap-hero__text { margin: 1.4rem 0 0; font-size: 1.5rem; letter-spacing: .08em; opacity: .92; }
  .ap-hero__button {
    margin-top: 2.6rem; display: inline-flex; align-items: center; justify-content: center;
    min-height: 4.8rem; padding: 0 3.4rem; border: 1px solid rgba(255,255,255,.9); border-radius: 999px;
    font-size: 1.15rem; letter-spacing: .28em; text-transform: uppercase;
    transition: background-color .3s ease, color .3s ease;
  }
  @media (hover: hover) {
    #ApHero-{{ section.id }} .ap-hero__link:hover .ap-hero__button { background: #fff; color: #1f1a16; }
  }

  /* Tekst: oude tekst gaat snel weg, nieuwe komt rustig na de foto binnen. */
  .ap-hero__slide .ap-hero__content > * {
    opacity: 0; transform: translateY(14px); transition: opacity .9s ease .5s, transform .9s var(--ap-ease) .5s;
  }
  .ap-hero__slide.is-leaving .ap-hero__content > * { opacity: 0; transform: none; transition: opacity .45s ease, transform .45s ease; }
  .ap-hero__slide.is-active .ap-hero__content > * { opacity: 1; transform: none; }
  .ap-hero__slide.is-active .ap-hero__content > *:nth-child(2) { transition-delay: .65s; }
  .ap-hero__slide.is-active .ap-hero__content > *:nth-child(3) { transition-delay: .8s; }
  .ap-hero__slide.is-active .ap-hero__content > *:nth-child(4) { transition-delay: .95s; }

  .ap-hero__controls {
    position: absolute; z-index: 3; left: 50%; bottom: 3.2rem; transform: translateX(-50%);
    display: flex; align-items: center; gap: 1.4rem;
  }
  .ap-hero__timer {
    position: relative; width: 3.6rem; height: 3.6rem; padding: 0; border: 0; background: none;
    color: #fff; cursor: pointer; display: grid; place-items: center;
  }
  .ap-hero__timer svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .ap-hero__ring-bg, .ap-hero__ring { fill: none; stroke-width: 1.5; }
  .ap-hero__ring-bg { stroke: rgba(255,255,255,.35); }
  .ap-hero__ring { stroke: #fff; stroke-dasharray: 100.53; stroke-dashoffset: 100.53; }
  .ap-hero.is-running .ap-hero__ring { animation: apHeroRing var(--ap-interval) linear forwards; }
  .ap-hero.is-paused .ap-hero__ring { animation-play-state: paused; }
  @keyframes apHeroRing { from { stroke-dashoffset: 100.53; } to { stroke-dashoffset: 0; } }
  .ap-hero__timer-icon { width: .5rem; height: .5rem; border-radius: 50%; background: #fff; }
  .ap-hero.is-paused .ap-hero__timer-icon {
    width: 0; height: 0; border-radius: 0; background: none;
    border-left: .8rem solid #fff; border-top: .5rem solid transparent; border-bottom: .5rem solid transparent; margin-left: .2rem;
  }
  .ap-hero__timer:focus-visible, .ap-hero__dot:focus-visible { outline: 1px solid #fff; outline-offset: 3px; }
  .ap-hero__dots { display: flex; gap: 1.2rem; margin: 0; padding: 0; list-style: none; }
  .ap-hero__dot {
    padding: .4rem .2rem; border: 0; background: none; cursor: pointer; color: rgba(255,255,255,.5);
    font-family: var(--font-body-family); font-size: 1.2rem; letter-spacing: .12em; transition: color .3s ease;
  }
  .ap-hero__dot.is-active, .ap-hero__dot:hover { color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .ap-hero__media img, .ap-hero__content > * { transition: none !important; transform: none !important; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('ApHero-{{ section.id }}');
    if (!root || root.dataset.apReady) return;
    root.dataset.apReady = '1';
    var slides = Array.prototype.slice.call(root.querySelectorAll('.ap-hero__slide'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-ap-go]'));
    var toggle = root.querySelector('[data-ap-toggle]');
    var ring = root.querySelector('.ap-hero__ring');
    var ms = (parseFloat(root.dataset.interval) || 6) * 1000;
    var FADE = 1600;
    var current = 0, timer = null, leaveTimer = null, pending = null, userPaused = false, focusPaused = false;
    if (slides.length < 2) return;

    function imgOf(s) { return s.querySelector('.ap-hero__media img'); }
    // Wacht tot de foto echt geladen is, zodat hij op iPhone niet ineens verschijnt.
    function whenReady(s, cb) {
      var img = imgOf(s), done = false;
      function go() { if (done) return; done = true; cb(); }
      if (!img || (img.complete && img.naturalWidth)) { go(); return; }
      img.addEventListener('load', go, { once: true });
      img.addEventListener('error', go, { once: true });
      setTimeout(go, 2500);
    }
    function warm(i) {
      var img = imgOf(slides[(i + slides.length) % slides.length]);
      if (img && img.decode) img.decode().catch(function () {});
    }
    function restartRing() {
      if (!ring) return;
      ring.style.animation = 'none';
      void ring.getBoundingClientRect();
      ring.style.animation = '';
    }
    function show(i) {
      var prev = current;
      current = (i + slides.length) % slides.length;
      clearTimeout(leaveTimer);
      slides.forEach(function (s, n) {
        var on = n === current;
        s.classList.remove('is-leaving');
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', on ? 'false' : 'true');
        var a = s.querySelector('.ap-hero__link');
        if (a) a.setAttribute('tabindex', on ? '0' : '-1');
      });
      if (prev !== current) {
        var leaving = slides[prev];
        leaving.classList.add('is-leaving');
        leaveTimer = setTimeout(function () { leaving.classList.remove('is-leaving'); }, FADE + 100);
      }
      dots.forEach(function (d, n) {
        d.classList.toggle('is-active', n === current);
        if (n === current) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
      });
      schedule();
      warm(current + 1);
    }
    function goTo(i) {
      var next = (i + slides.length) % slides.length;
      if (next === current) { schedule(); return; }
      var token = pending = {};
      whenReady(slides[next], function () { if (pending === token) show(next); });
    }
    function schedule() {
      clearTimeout(timer);
      var paused = userPaused || focusPaused || document.hidden;
      root.classList.toggle('is-paused', paused);
      root.classList.toggle('is-running', !paused);
      if (!paused) {
        restartRing();
        timer = setTimeout(function () { goTo(current + 1); }, ms);
      }
    }
    function setUserPaused(p) {
      userPaused = p;
      if (toggle) {
        toggle.setAttribute('aria-pressed', p ? 'true' : 'false');
        toggle.setAttribute('aria-label', p ? {{ 'aljarah_corrections.play' | t | json }} : {{ 'aljarah_corrections.pause' | t | json }});
      }
      schedule();
    }

    dots.forEach(function (d) {
      d.addEventListener('click', function () { goTo(parseInt(d.dataset.apGo, 10)); });
    });
    if (toggle) toggle.addEventListener('click', function () { setUserPaused(!userPaused); });
    // Muis of klikken pauzeert niet; alleen toetsenbordgebruikers (Tab) krijgen een pauze.
    root.addEventListener('focusin', function (e) {
      var keyboard = false;
      try { keyboard = e.target.matches(':focus-visible'); } catch (err) { keyboard = false; }
      if (!keyboard) return;
      focusPaused = true; schedule();
    });
    root.addEventListener('focusout', function (e) {
      if (focusPaused && !root.contains(e.relatedTarget)) { focusPaused = false; schedule(); }
    });
    document.addEventListener('visibilitychange', schedule);
    // iPhone zet pagina's soms "in de wacht" (terug-knop, tabbladen); bij terugkomen weer starten.
    window.addEventListener('pageshow', function () { focusPaused = false; schedule(); });

    var startX = null, startY = null, swiped = false;
    root.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX; startY = e.touches[0].clientY; swiped = false;
    }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var dx = e.changedTouches[0].clientX - startX, dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) { swiped = true; goTo(current + (dx < 0 ? 1 : -1)); }
      startX = null;
    });
    root.addEventListener('click', function (e) {
      if (swiped && e.target.closest('.ap-hero__link')) { e.preventDefault(); swiped = false; }
    }, true);
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') goTo(current + 1);
      if (e.key === 'ArrowLeft') goTo(current - 1);
    });

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:block:select', function (e) {
        var i = slides.indexOf(e.target);
        if (i > -1) { setUserPaused(true); show(i); }
      });
    }
    // Ook bij "Beperk beweging" loopt de slideshow door (zonder zoom-effect, zie CSS); het rondje blijft de pauzeknop.
    warm(1);
    schedule();
  })();
</script>

{% schema %}
{
  "name": "AP slideshow",
  "tag": "div",
  "class": "section-ap-hero",
  "settings": [
    { "type": "text", "id": "label", "label": "Naam voor schermlezers", "default": "Uitgelicht" },
    { "type": "range", "id": "interval", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Tijd per slide", "default": 6 },
    {
      "type": "select", "id": "height", "label": "Hoogte",
      "options": [ { "value": "tall", "label": "Groot" }, { "value": "medium", "label": "Middel" } ],
      "default": "tall"
    },
    {
      "type": "select", "id": "text_position", "label": "Positie tekst",
      "options": [ { "value": "bottom", "label": "Onderin" }, { "value": "middle", "label": "Midden" } ],
      "default": "bottom"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Afbeelding" },
        { "type": "image_picker", "id": "image_mobile", "label": "Afbeelding mobiel (optioneel)" },
        {
          "type": "select", "id": "focal", "label": "Focuspunt",
          "options": [
            { "value": "object-position: 50% 50%", "label": "Midden" },
            { "value": "object-position: 50% 25%", "label": "Boven" },
            { "value": "object-position: 50% 75%", "label": "Onder" },
            { "value": "object-position: 30% 50%", "label": "Links" },
            { "value": "object-position: 70% 50%", "label": "Rechts" }
          ],
          "default": "object-position: 50% 50%"
        },
        { "type": "text", "id": "eyebrow", "label": "Klein kopje", "default": "Nieuw binnen" },
        { "type": "text", "id": "heading", "label": "Kop", "default": "Luxe voor elke dag" },
        { "type": "text", "id": "text", "label": "Tekst (optioneel)" },
        { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Shop nu" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "AP slideshow", "blocks": [ { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}
