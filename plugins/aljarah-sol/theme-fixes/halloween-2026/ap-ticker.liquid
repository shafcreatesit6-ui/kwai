{%- comment -%}
  AP: lopende actiebalk bovenaan (Halloween -25%).
  Alleen zichtbaar tot de einddatum; daarna verschijnt vanzelf weer de gewone aankondigingsbalk.
{%- endcomment -%}
{%- liquid
  assign ap_tk_now = 'now' | date: '%s' | plus: 0
  assign ap_tk_end = section.settings.end_ts | plus: 0
  assign ap_tk_on = false
  if section.settings.enable and ap_tk_now < ap_tk_end
    assign ap_tk_on = true
  endif
  if request.design_mode and section.settings.enable
    assign ap_tk_on = true
  endif
-%}
{%- if ap_tk_on and section.blocks.size > 0 -%}
  <div class="ap-tk" role="region" aria-label="{{ section.settings.label | escape }}">
    {%- capture ap_tk_items -%}
      {%- for block in section.blocks -%}
        <span class="ap-tk__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
        <span class="ap-tk__dot" aria-hidden="true">{{ section.settings.separator | escape }}</span>
      {%- endfor -%}
    {%- endcapture -%}
    <a class="ap-tk__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
      <span class="visually-hidden">
        {%- for block in section.blocks -%}{{ block.settings.text | escape }}. {% endfor -%}
      </span>
      <span class="ap-tk__track" aria-hidden="true">
        {%- for i in (1..4) -%}
          <span class="ap-tk__group">{{ ap_tk_items }}</span>
        {%- endfor -%}
      </span>
    </a>
  </div>
  <style>
    .ap-tk { background: {{ section.settings.bg }}; color: {{ section.settings.fg }}; overflow: hidden; }
    .ap-tk__link { display: block; color: inherit; text-decoration: none; }
    .ap-tk__track { display: flex; width: max-content; animation: apTk {{ section.settings.speed }}s linear infinite; }
    .ap-tk__group { display: flex; align-items: center; flex: none; }
    .ap-tk__item { padding: 1rem 0; font-size: 1.15rem; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; white-space: nowrap; }
    .ap-tk__dot { padding: 0 1.6rem; color: {{ section.settings.accent }}; font-size: 1.3rem; }
    .ap-tk:hover .ap-tk__track { animation-play-state: paused; }
    @keyframes apTk { from { transform: translateX(0); } to { transform: translateX(-25%); } }
    @media (prefers-reduced-motion: reduce) {
      .ap-tk__track { animation: none; }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "AP lopende actiebalk",
  "tag": "div",
  "class": "ap-tk-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Balk aan", "default": true },
    { "type": "text", "id": "end_ts", "label": "Verbergen na (Unix-tijd in seconden)", "info": "1793573999 = zondag 1 nov 2026, 23:59 Spaanse tijd", "default": "1793573999" },
    { "type": "text", "id": "label", "label": "Naam voor schermlezers", "default": "Promoción" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "separator", "label": "Scheidingsteken", "default": "🎃" },
    { "type": "range", "id": "speed", "min": 10, "max": 80, "step": 2, "unit": "s", "label": "Snelheid (hoger = trager)", "default": 36 },
    { "type": "color", "id": "bg", "label": "Achtergrond", "default": "#14100d" },
    { "type": "color", "id": "fg", "label": "Tekst", "default": "#f7f3ec" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#f28c28" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Tekst",
      "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Halloween: 25% de descuento" } ]
    }
  ],
  "presets": [ { "name": "AP lopende actiebalk" } ]
}
{% endschema %}
